<div class="row">
    <div class="col-md-4">
        <h2 class="mb-4">Mi Tablero</h2>
        
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Añadir Tarea</h5>
                <form action="/nueva-tarjeta" method="POST">
                    <div class="mb-3">
                        <input type="text" name="title" class="form-control" placeholder="Nombre de la tarea..." required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar Tarea</button>
                </form>
            </div>
        </div>

        <div class="list-group">
            {{#each tasks}}
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center mb-2 shadow-sm border-start border-primary border-4">
                <span>{{this.title}}</span>
                <span class="badge bg-secondary rounded-pill">{{this.status}}</span>
            </div>
            {{else}}
            <p class="text-muted">No hay tareas pendientes. ¡Crea la primera!</p>
            {{/each}}
        </div>
    </div>
</div>