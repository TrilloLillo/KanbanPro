<script>
    // Initialize Drag and Drop
    document.addEventListener('DOMContentLoaded', () => {
        const columns = document.querySelectorAll('.kanban-column');
        columns.forEach(column => {
            new Sortable(column, {
                group: 'kanban',
                animation: 150,
                ghostClass: 'sortable-ghost',
                dragClass: 'sortable-drag',
                onEnd: () => {
                    updateCounts();
                }
            });
        });

        // Event delegation for delete buttons
        document.body.addEventListener('click', (e) => {
            if (e.target.closest('.delete-card')) {
                const card = e.target.closest('.kanban-card');
                card.classList.add('scale-0', 'opacity-0');
                setTimeout(() => {
                    card.remove();
                    updateCounts();
                }, 300);
            }
        });
    });

    // Helper: Update column task counts
    function updateCounts() {
        document.getElementById('count-todo').textContent = document.getElementById('todo-list').children.length;
        document.getElementById('count-doing').textContent = document.getElementById('doing-list').children.length;
        document.getElementById('count-done').textContent = document.getElementById('done-list').children.length;
    }

    // Function: Add new task
    function addNewTask(columnId) {
        const list = document.getElementById(`${columnId}-list`);
        const theme = columnId === 'todo' ? 'secondary-container/20' : 
                      columnId === 'doing' ? 'tertiary-container/30' : 'white border-primary/10';
        const textColor = columnId === 'todo' ? 'on-secondary-container' : 
                          columnId === 'doing' ? 'on-tertiary-container' : 'zinc-400';
        
        const card = document.createElement('article');
        card.className = `kanban-card bg-${theme} p-6 rounded-xl shadow-xl border-2 border-white relative group cursor-grab active:cursor-grabbing transition-all`;
        
        card.innerHTML = `
            <div class="flex justify-between items-start mb-4">
                <span class="bg-primary/20 text-primary px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase">New</span>
                <button class="text-zinc-300 hover:text-error-dim transition-colors delete-card"><span class="material-symbols-outlined text-sm">close</span></button>
            </div>
            <h4 contenteditable="true" class="font-bold text-lg mb-4 text-${textColor} leading-tight focus:outline-none">New sweet task...</h4>
            <div class="flex items-center justify-between mt-4">
                <div class="flex -space-x-2">
                    <div class="w-7 h-7 rounded-full bg-primary-container flex items-center justify-center text-[10px] text-white font-bold border-2 border-white">ME</div>
                </div>
                <div class="flex items-center gap-2 text-zinc-400 text-xs">
                    <span class="material-symbols-outlined text-sm">schedule</span>
                    <span>Just now</span>
                </div>
            </div>
        `;
        
        list.appendChild(card);
        card.querySelector('h4').focus();
        updateCounts();
    }

    // Function: Toggle checklist items
    function toggleCheck(element) {
        const checkbox = element.querySelector('.check-box') || element.querySelector('div:first-child');
        const text = element.querySelector('span');
        const isChecked = text.classList.contains('line-through');

        if (isChecked) {
            text.classList.remove('line-through', 'opacity-50');
            checkbox.innerHTML = '';
            checkbox.classList.add('border-2');
            checkbox.classList.remove('bg-primary');
        } else {
            text.classList.add('line-through', 'opacity-50');
            checkbox.classList.remove('border-2');
            checkbox.classList.add('bg-primary');
            checkbox.innerHTML = '<span class="material-symbols-outlined text-[12px] text-white" style="font-variation-settings: \'FILL\' 1;">favorite</span>';
        }
    }
</script>
</body>



