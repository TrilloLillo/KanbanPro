<div class="container">
    
    <h2 class="mb-4">Hola {{userName}} — Mis Tableros</h2>

    <div class="mb-3">
        <form action="/api/tableros" method="POST" class="d-flex" style="max-width:480px; gap:.5rem;">
            <input name="titulo" type="text" class="form-control" placeholder="Título del tablero" required>
            <button type="submit" class="btn btn-success">Crear Tablero</button>
        </form>
    </div>

    {{#if tableros}}
        {{#if tableros.length}}
            {{#each tableros}}
                <div class="card mb-4 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="m-0">{{this.titulo}}</h5>
                        <form action="/api/listas/tablero/{{this.id}}" method="POST" class="d-flex align-items-center" style="gap:.5rem;">
                            <input name="titulo" type="text" class="form-control form-control-sm" placeholder="Nueva lista" required style="max-width:200px;">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Crear Lista</button>
                        </form>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            {{#each this.Listas}}
                                <div class="col-md-4">
                                    <div class="card mb-3">
                                        <div class="card-header"><strong>{{this.titulo}}</strong></div>
                                        <div class="card-body">
                                            {{#each this.Tarjetas}}
                                                <div class="card mb-2 shadow-sm">
                                                    <div class="card-body p-2">{{this.titulo}}</div>
                                                </div>
                                            {{else}}
                                                <p class="text-muted mb-0">No hay tarjetas</p>
                                            {{/each}}
                                        </div>
                                    </div>
                                </div>
                            {{else}}
                                <p class="text-muted">Este tablero no tiene listas aún.</p>
                            {{/each}}
                        </div>
                    </div>
                </div>
            {{/each}}
        {{else}}
            <p class="text-muted">No tienes tableros todavía.</p>
        {{/if}}
    {{else}}
        <p class="text-muted">No tienes tableros todavía.</p>
    {{/if}}
</div>